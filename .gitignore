# Local config — contains real mount paths, bandwidth limits, and the
# JABS API key. Never committed; nas_sync.conf.example is the committed template.
nas_sync.conf

# NAS2 rsync daemon module password (referenced by NAS2_RSYNC_PASSWORD_FILE)
nas2.rsync.secret

# Runtime state
nas_sync.lock
nas_sync.pid
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class

# Environment variables (not currently used by this agent, but reserved)
.env
.env.local
.env.*.local

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
