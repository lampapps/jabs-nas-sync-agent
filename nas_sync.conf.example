# =============================================================================
# nas_sync.conf.example — Template for nas_sync.conf
# =============================================================================
# Copy this file to nas_sync.conf and fill in your values.
# nas_sync.conf is gitignored and will never be committed.
# =============================================================================

# ── NAS1: local NFS mount point on THIS client machine ────────────────────
NAS1_MOUNT="/mnt/nas1"

# ── NAS2: remote Asustor, reached via its rsync daemon (ADM "Rsync Server")
# over Tailscale — NOT an NFS mount. See README.md for the Asustor-side setup.
NAS2_RSYNC_HOST="100.64.0.2"          # NAS2's Tailscale IP or MagicDNS name
NAS2_RSYNC_MODULE="module_name"       # module defined in ADM's Rsync Server
NAS2_RSYNC_USER="syncuser"            # rsync module username
NAS2_RSYNC_PASSWORD_FILE="${SCRIPT_DIR}/nas2.rsync.secret"   # chmod 600, gitignored

# ── Bandwidth limits (KB/s) ───────────────────────────────────────────────
# Set per direction based on the SENDER'S upload speed.
# The bottleneck is always the uplink of whichever NAS is sending data.
#   0 = unlimited
#
# Sizing guide:
#   ~40 Mbps uplink  →  4600 KB/s (90% headroom)
#   ~100 Mbps uplink → 11500 KB/s
#   ~200 Mbps uplink → 23000 KB/s
BWLIMIT_NAS1_TO_NAS2=4600
BWLIMIT_NAS2_TO_NAS1=23000

# ── Minimum free space on destination before syncing (bytes) ─────────────
MIN_FREE_BYTES=$((10 * 1024 * 1024 * 1024))   # 10 GiB

# ── Stop / deadline time ─────────────────────────────────────────────────
# Hard wall-clock deadline (Top of the hour only, 24-hour, local time).  When the script is still
# running at this hour it stops gracefully: the current rsync is sent SIGTERM
# so it exits cleanly, --partial keeps the incomplete file, and the next cron
# run resumes exactly where this one left off.
# Set to "" or leave unset to disable the deadline.
# Plain integer (0–23) with no quotes
STOP_HOUR=8

# ── Log retention ─────────────────────────────────────────────────────────
# Number of days to retain the logs.
LOG_RETENTION_DAYS=30

# ── Integrity checks ──────────────────────────────────────────────────────
# Low-cost quick verify after every sync: an rsync --dry-run comparison of
# size/mtime only (no file content is read), so it costs about the same as
# the sync's own scan. Any leftover differences are logged and reported to
# JABS, but never fail the already-completed sync. Set to "false" to disable.
# For a thorough (slow) check that reads and compares actual file content,
# run manually: ./nas_sync.sh check-deep [--pair NAME]
VERIFY_AFTER_SYNC=true

# ── In-transit compression (optional) ─────────────────────────────────────
# rsync's --compress: trades CPU for WAN bandwidth. Helps compressible data
# (text, logs, configs, uncompressed media) over a slow WAN link; little/no
# benefit — and wasted CPU — for already-compressed data (jpg, mp4, zip,
# encrypted archives, etc.). Off by default; enable and benchmark a real run
# before relying on it.
RSYNC_COMPRESS=false

# Compression level 1 (fastest/least) to 9 (slowest/most). Leave empty for
# rsync's own default (~6). Only used when RSYNC_COMPRESS=true.
RSYNC_COMPRESS_LEVEL=""

# Comma-separated list of filename suffixes rsync should NOT try to compress
# (passed to --skip-compress). Leave empty to use rsync's own built-in
# default skip list (common already-compressed formats). Only used when
# RSYNC_COMPRESS=true.
RSYNC_SKIP_COMPRESS=""

# ── Uptime Kuma telemetry ────────────────────────────────────────────
# Create a Push monitor in Uptime Kuma or compatible monitor, then paste its push URL below.
# Sends up/down heartbeats so failures and missed runs trigger alerts.
# Requires curl.  Set to "" to disable.
UPTIME_KUMA_URL=""
# UPTIME_KUMA_URL="https://<your-uptime-kuma>/api/push/<token>"

# ── JABS agent monitoring ──────────────────────────────────────────────────
# Reports each pair as a job to the JABS dashboard (see AGENT_API_GUIDE.md /
# https://github.com/<org>/jabs). Requires python3. Set JABS_DASHBOARD_URL=""
# to disable — everything below is then ignored. (JABS_SERVER_URL is still
# accepted as a deprecated alias.)
#
# IMPORTANT: register this agent on the JABS dashboard's Agents page first —
# there is no self-registration API. Registering returns a unique API key;
# paste it into JABS_AGENT_KEY below. Each agent instance (even multiple on
# the same machine) should get its own key.
JABS_DASHBOARD_URL="http://10.10.2.10:5001"

# API key for this agent, generated when you register it on the dashboard.
JABS_AGENT_KEY=""

# Per-request timeout (seconds) for calls to the JABS dashboard.
JABS_TIMEOUT=10

# Name shown in the dashboard's Job Name column. One job name covers the
# entire run of this script (all pairs, both directions) — it is not
# per-pair; each pair still shows its own direction/label as its target.
JOB_NAME="NAS Sync"

# Optional: cron expression matching this script's entry in the host's
# crontab (e.g. "0 2 * * *"). Purely advisory — reported to the dashboard
# to compute its "Next Event" column; this script still only runs whenever
# cron actually invokes it, regardless of this value.
#JOB_CRON="0 2 * * *"

# ── Sync pairs ────────────────────────────────────────────────────────────
# Format: each element is "SOURCE_SUBDIR:DEST_SUBDIR"
# Paths are relative to the respective NAS mount points.
# Example: "documents:documents" means
#          ${NAS1_MOUNT}/documents  →  ${NAS2_MOUNT}/documents

# NAS1 → NAS2
NAS1_TO_NAS2_PAIRS=(
#   "backups:backups"
#   "media/music:media/music"
)

# NAS2 → NAS1
NAS2_TO_NAS1_PAIRS=(
#   "documents:documents"
)
